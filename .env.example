# Frontend Next.js Storefront - Environment Configuration

# Medusa v2 Store API
# URL backendu Medusa v2 (lokalnie http://localhost:9000, w produkcji URL Twojego serwera)
NEXT_PUBLIC_MEDUSA_BACKEND_URL="http://localhost:9000"

# Klucz publiczny pobrany z panelu Medusa Admin: Settings -> Publishable API Keys -> Twój klucz
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY="pk_01J..."

# Opcjonalnie: Supabase / Backend Database (wykorzystywany w konfiguracji backendu Medusa medusa-config.ts)
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require"

# Resend & Transactional Emails (React Email)
# Klucz API wygenerowany na resend.com
RESEND_API_KEY="re_123456789..."
# Zweryfikowana domena wysyłkowa
EMAIL_FROM="CBD Master <objednavky@cbd-master.cz>"

# Medusa v2 Webhook Secret (do autoryzacji webhooków z backendu do Next.js)
MEDUSA_WEBHOOK_SECRET="super_secret_webhook_token_here"

# Host URL sklepu
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
